# Runtime preferences written next to the EXE at first launch.
gateway.json

# Runtime data: the provider library holds the user's captured configs.
providers.json
mcp.json
# Custom third-party API providers; stores API keys in cleartext, so it must
# never be committed.
custom-providers.json

